{
  "preview": {
    "enable_cursor": true,
    "scroll_down": "j",
    "scroll_up": "k",
    "scroll_right": "l",
    "scroll_left": "h",
    "prev_file": "Alt+Shift+H",
    "next_file": "Alt+Shift+L",
    "close_app": "Ctrl+q",
    "save_file": "w",
    "cycle_mode": "Shift+Tab",
    "toggle_toc": "Alt+O"
  },
  "toc": {
    "mode": "side_tab",
    "side_tab": {
      "width_percent": 20,
      "position": "left",
      "nav_down": "j",
      "nav_up": "k"
    },
    "floating_window": {
      "width_percent": 50,
      "height_percent": 60,
      "position": "center",
      "nav_down": "j",
      "nav_up": "k"
    }
  },
  "theme": {
    "heading_color": "#58a6ff",
    "bold_color": "#f0883e",
    "italic_color": "#d29922",
    "inline_code_color": "#ff7b72",
    "inline_code_bg": "#21262d",
    "link_color": "#58a6ff",
    "blockquote_color": "#8b949e",
    "text_color": "#c9d1d9",
    "table_border_color": "#30363d",
    "hr_color": "#30363d"
  },
  "fonts": {
    "ui_font": "System Default",
    "custom_ui_font": "",
    "code_font": "System Monospace",
    "custom_code_font": "",
    "preview_font_size": 14.5,
    "editor_font_size": 13
  },
  "settings": {
    "middle_click_close_tab": true,
    "is_copy_to_yank": true,
    "scroll_step_y": 60,
    "scroll_step_x": 60,
    "max_fps": 60
  }
}
